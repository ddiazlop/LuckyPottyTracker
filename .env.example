# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Development-only switch. Set VITE_SEED_SAMPLE_DATA=true in .env.local to give a
# fresh local store sample records and the default dog profile at startup.
# The flag is ignored in production builds and never re-seeds once records exist.
VITE_SEED_SAMPLE_DATA=false
